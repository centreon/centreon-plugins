# Fake aws CLI for the cloudwatchlogs robot tests (--custommode=awscli --command-path=<this dir>).
# It prints the JSON fixtures of ../data for the commands used by the plugin.

DATA_DIR="$(dirname "$0")/../data"

case "$*" in
    *"logs describe-log-groups"*)
        cat "$DATA_DIR/describe-log-groups.json"
        ;;
    *"logs filter-log-events"*"--log-stream-names"*"app-stream-2"*)
        cat "$DATA_DIR/filter-log-events-app-stream-2.json"
        ;;
    *"logs filter-log-events"*)
        cat "$DATA_DIR/filter-log-events.json"
        ;;
    *)
        echo "unknown command: $*" >&2
        exit 1
        ;;
esac
