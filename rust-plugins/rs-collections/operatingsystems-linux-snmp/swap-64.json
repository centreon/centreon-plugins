{
  "collect": {
    "snmp": [
      {
        "name": "memTotalSwap",
        "oid": ".1.3.6.1.4.1.2021.4.18.0",
        "query": "Get"
      },
      {
        "name": "memAvailSwap",
        "oid": ".1.3.6.1.4.1.2021.4.19.0",
        "query": "Get"
      }
    ]
  },
  "compute": {
    "metrics": [],
    "aggregations": [
      {
        "name": "used",
        "value": "({memTotalSwap} - {memAvailSwap}) * 1024",
        "uom": "B",
        "min": 0,
        "max_expr": "{memTotalSwap} * 1024",
        "threshold-suffix": "usage",
        "output": "Swap Total: {Bytes(aggregations.total)} Used: {Bytes(aggregations.used)} ({aggregations.used_prct:.2f}%) Free: {Bytes(aggregations.free)} ({aggregations.free_prct:.2f}%)",
        "order": 0
      },
      {
        "name": "free",
        "value": "{memAvailSwap} * 1024",
        "uom": "B",
        "min": 0,
        "max_expr": "{memTotalSwap} * 1024",
        "threshold-suffix": "usage-free",
        "output": "Swap Total: {Bytes(aggregations.total)} Used: {Bytes(aggregations.used)} ({aggregations.used_prct:.2f}%) Free: {Bytes(aggregations.free)} ({aggregations.free_prct:.2f}%)",
        "order": 1
      },
      {
        "name": "used_prct",
        "value": "100 * ({memTotalSwap} - {memAvailSwap}) / {memTotalSwap}",
        "uom": "%",
        "min": 0,
        "max": 100,
        "threshold-suffix": "usage-prct",
        "decimals": 2,
        "output": "Used : {aggregations.used_prct:.2f} %",
        "order": 2
      },
      {
        "name": "free_prct",
        "value": "100 * {memAvailSwap} / {memTotalSwap}",
        "uom": "%",
        "perfdata": false
      },
      {
        "name": "total",
        "value": "{memTotalSwap} * 1024",
        "uom": "B",
        "perfdata": false
      }
    ]
  },
  "output": {
    "ok": "OK: Swap Total: {Bytes(aggregations.total)} Used: {Bytes(aggregations.used)} ({aggregations.used_prct:.2f}%) Free: {Bytes(aggregations.free)} ({aggregations.free_prct:.2f}%)",
    "warning": "WARNING: ",
    "detail_warning": true,
    "critical": "CRITICAL: ",
    "detail_critical": true,
    "instance_separator": " - ",
    "metric_separator": ", "
  }
}
